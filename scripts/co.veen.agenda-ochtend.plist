<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>co.veen.agenda-ochtend</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/victorvanderveen/Claude Code/weekplanner/scripts/agenda-ochtend.sh</string>
  </array>
  <!-- Werkdagen 06:52: net na pmset-wake 06:50 en de serverrun (obsidian-ochtend.timer).
       Slaapt de Mac toch, dan haalt launchd de run in bij openklappen.
       Installeren: kopie naar ~/Library/LaunchAgents/ + launchctl bootstrap. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>52</integer><key>Weekday</key><integer>1</integer></dict>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>52</integer><key>Weekday</key><integer>2</integer></dict>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>52</integer><key>Weekday</key><integer>3</integer></dict>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>52</integer><key>Weekday</key><integer>4</integer></dict>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>52</integer><key>Weekday</key><integer>5</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/tmp/agenda-ochtend.log</string>
  <key>StandardErrorPath</key><string>/tmp/agenda-ochtend.log</string>
</dict>
</plist>
